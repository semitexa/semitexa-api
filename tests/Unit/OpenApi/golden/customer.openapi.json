    "components": {
        "schemas": {
            "AddressResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "line1": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "city",
                    "line1"
                ]
            },
            "CustomerResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string",
                        "description": "Display name of the customer."
                    },
                    "profile": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/ResourceRef_ProfileResource"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "addresses": {
                        "$ref": "#/components/schemas/ResourceRefList_AddressResource"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "addresses"
                ]
            },
            "ProfilePreferencesResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "theme": {
                        "type": "string",
                        "description": "UI theme preference (e.g. light/dark/auto)."
                    },
                    "locale": {
                        "type": "string",
                        "description": "IETF BCP 47 language tag preferred by the user."
                    }
                },
                "required": [
                    "id",
                    "theme",
                    "locale"
                ]
            },
            "ProfileResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "bio": {
                        "type": "string"
                    },
                    "preferences": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/ResourceRef_ProfilePreferencesResource"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "required": [
                    "id",
                    "bio"
                ]
            },
            "ResourceRefList_AddressResource": {
                "type": "object",
                "description": "To-many reference envelope for AddressResource. href is mandatory in the public factory; data is present when embedded; total accompanies data.",
                "required": [
                    "href"
                ],
                "properties": {
                    "href": {
                        "type": "string",
                        "format": "uri-reference"
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/AddressResource"
                        }
                    },
                    "total": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "additionalProperties": false
            },
            "ResourceRef_ProfilePreferencesResource": {
                "type": "object",
                "description": "To-one reference envelope for ProfilePreferencesResource. type+id are mandatory; href is optional; data is present when embedded.",
                "required": [
                    "type",
                    "id"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "const": "profile_preferences"
                    },
                    "id": {
                        "type": "string"
                    },
                    "href": {
                        "type": "string",
                        "format": "uri-reference"
                    },
                    "data": {
                        "$ref": "#/components/schemas/ProfilePreferencesResource"
                    }
                },
                "additionalProperties": false
            },
            "ResourceRef_ProfileResource": {
                "type": "object",
                "description": "To-one reference envelope for ProfileResource. type+id are mandatory; href is optional; data is present when embedded.",
                "required": [
                    "type",
                    "id"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "const": "profile"
                    },
                    "id": {
                        "type": "string"
                    },
                    "href": {
                        "type": "string",
                        "format": "uri-reference"
                    },
                    "data": {
                        "$ref": "#/components/schemas/ProfileResource"
                    }
                },
                "additionalProperties": false
            }
